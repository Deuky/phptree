#!/usr/bin/env php
<?php

declare(strict_types=1);

(static function (): void {
    $autoloadPaths = [
        __DIR__ . '/../vendor/autoload.php',       // dev / composer global
        __DIR__ . '/../../../autoload.php',         // installé via composer global require
    ];

    $autoloaded = false;
    foreach ($autoloadPaths as $path) {
        if (file_exists($path)) {
            require_once $path;
            $autoloaded = true;
            break;
        }
    }

    if (!$autoloaded) {
        fwrite(STDERR, "Autoloader introuvable. Lancez `composer install`.\n");
        exit(1);
    }

    $app = new \Symfony\Component\Console\Application('phptree', '0.1.0');
    $app->add(new \PhpTree\Command\ScanCommand());
    $app->setDefaultCommand('scan', false);
    $app->run();
})();